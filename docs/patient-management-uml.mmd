  Main ..> Scanner : creates
  Main ..> StartMSG : prints startup text
  Main ..> BootConfigService : creates and starts

  BootConfigService ..> LoaderMSG : displayLoader()
  BootConfigService ..> AuthController : creates
  BootConfigService ..> ConfigController : creates
  BootConfigService ..> MenuController : creates placeholder
  BootConfigService ..> ServiceController : creates placeholder
  BootConfigService ..> uiController : creates placeholder
  BootConfigService ..> FrontController : creates dispatcher
  BootConfigService ..> RequestType : routes CONFIG then AUTH

  FrontController *-- AuthController : holds
  FrontController *-- ConfigController : holds
  FrontController *-- MenuController : holds
  FrontController *-- ServiceController : holds
  FrontController *-- uiController : holds
  FrontController ..> RequestType : switch
  FrontController ..> ConfigController : CONFIG route
  FrontController ..> AuthController : AUTH route
  FrontController ..> Scanner : passes input

  ConfigController ..> EnvValidationService : creates and validates
  ConfigController ..> SQLValidationService : creates and connects
  ConfigController ..> DBManager : initialize runtime config
  ConfigController ..> CheckForDefaultAccounts : checks starter accounts

  EnvValidationService ..> ConfigMSG : prints config header
  EnvValidationService ..> File : checks .env
  EnvValidationService ..> Dotenv : loads values
  EnvValidationService ..> EnvFile : validates required keys

  SQLValidationService --> EnvValidationService : reads DB values
  SQLValidationService ..> DriverManager : tests connection
  SQLValidationService ..> Connection : opens test connection
  SQLValidationService ..> SQLException : handles errors

  DBManager ..> DriverManager : opens configured connections
  DBManager ..> Connection : returns
  DBManager ..> SQLException : throws

  CheckForDefaultAccounts ..> DBManager : getConnection()
  CheckForDefaultAccounts ..> PreparedStatement : SELECT accounts
  CheckForDefaultAccounts ..> ResultSet : checks role rows
  CheckForDefaultAccounts ..> CreateDefaultAccounts : creates missing accounts
  CheckForDefaultAccounts ..> AccountsTable : reads
  CheckForDefaultAccounts ..> RolesTable : uses role IDs 1 and 2

  CreateDefaultAccounts ..> Dotenv : reads default account values
  CreateDefaultAccounts ..> EnvFile : reads admin credentials
  CreateDefaultAccounts ..> BCrypt : hashes default passwords
  CreateDefaultAccounts ..> DBManager : getConnection()
  CreateDefaultAccounts ..> PreparedStatement : INSERT accounts
  CreateDefaultAccounts ..> AccountsTable : writes
  CreateDefaultAccounts ..> DepartmentsTable : uses IT and System IDs
  CreateDefaultAccounts ..> AccountStatusTable : uses waiting_for_password_change
  CreateDefaultAccounts ..> RolesTable : uses local_admin/admin

  AuthController ..> AuthMenu : displays auth menu
  AuthController ..> RegistrationFlow : option 1
  AuthController ..> LoginFlow : option 2
  AuthController ..> Scanner : reads menu input

  RegistrationFlow ..> RegistrationService : collects profile data
  RegistrationFlow ..> CreateAccount : persists pending account
  RegistrationService ..> Scanner : reads profile data
  RegistrationService ..> PasswordFlow : creates password hash
  PasswordFlow ..> PasswordService : validates and hashes password
  PasswordService ..> Scanner : fallback password input
  PasswordService ..> Console : hidden password input
  PasswordService ..> BCrypt : hashpw()

  CreateAccount ..> DBManager : getConnection()
  CreateAccount ..> PreparedStatement : INSERT account
  CreateAccount ..> AccountsTable : writes pending intern account
  CreateAccount ..> AccountStatusTable : uses pending
  CreateAccount ..> RolesTable : uses intern
  CreateAccount ..> DepartmentsTable : uses unassigned

  LoginFlow ..> LoginInputCollector : collects credentials
  LoginFlow ..> LoginVerification : verifies credentials
  LoginFlow ..> RepositoryCollectLogs : persists login attempt
  LoginFlow ..> AuthCollectLogs : reads result object
  LoginInputCollector ..> Scanner : username input
  LoginInputCollector ..> Console : hidden password input

  LoginVerification *-- CheckUserInDB : repository field
  LoginVerification ..> UserStatus : documents possible status values
  LoginVerification ..> AuthCollectLogs : returns result object
  LoginVerification ..> FirstLogin : pending account setup
  LoginVerification ..> SQLException : handles login SQL errors
  LoginVerification ..> Scanner : passes to FirstLogin

  CheckUserInDB ..> DBManager : getConnection()
  CheckUserInDB ..> PreparedStatement : SELECT account/hash/status
  CheckUserInDB ..> ResultSet : reads records
  CheckUserInDB ..> BCrypt : checkpw()
  CheckUserInDB ..> AccountsTable : reads
  CheckUserInDB ..> AccountStatusTable : joins account status

  RepositoryCollectLogs ..> DBManager : getConnection()
  RepositoryCollectLogs ..> PreparedStatement : SELECT account and INSERT log
  RepositoryCollectLogs ..> ResultSet : reads account id
  RepositoryCollectLogs ..> AccountsTable : reads account id
  RepositoryCollectLogs ..> LoginAttemptsTable : writes

  FirstLogin ..> DepartmentMenu : shows department choices
  FirstLogin ..> SelectDepartment : validates selected department
  FirstLogin ..> MedicalJobsMenu : department 1
  FirstLogin ..> EmergencyJobsMenu : department 2
  FirstLogin ..> LaboratoryJobsMenu : department 3
  FirstLogin ..> PharmacyJobsMenu : department 4
  FirstLogin ..> itJobsMenu : department 5
  FirstLogin ..> SecurityJobsMenu : department 6
  FirstLogin ..> FinanceJobsMenu : department 7
  FirstLogin ..> OfficeJobsMenu : department 8
  FirstLogin ..> AdministrationJobsMenu : department 9
  FirstLogin ..> TrainingJobsMenu : department 10
  FirstLogin ..> SystemJobsMenu : department 11
  FirstLogin ..> HandleAccessManagement : stores access request

  SelectDepartment ..> Scanner : reads department id
  RoleValidation ..> Scanner : reads role id
  RoleValidation ..> roleMenu : shows role menu

  HandleAccessManagement ..> DBManager : getConnection()
  HandleAccessManagement ..> PreparedStatement : SELECT account and INSERT request
  HandleAccessManagement ..> ResultSet : reads account id
  HandleAccessManagement ..> AccountsTable : reads requester
  HandleAccessManagement ..> AccessManagementTable : writes access request
  HandleAccessManagement ..> DepartmentsTable : requested_department
  HandleAccessManagement ..> RolesTable : requested_role default intern

  CheckRoles ..> DBManager : getConnection()
  CheckRoles ..> PreparedStatement : SELECT role
  CheckRoles ..> ResultSet : reads user_role
  CheckRoles ..> AccountsTable : reads
  CheckRoles ..> RolesTable : checks assigned role

  AccountsTable --> RolesTable : user_role
  AccountsTable --> AccountStatusTable : account_status
  AccountsTable --> DepartmentsTable : department
  LoginAttemptsTable --> AccountsTable : account_id
  AccessManagementTable --> AccountsTable : requested_by and approved_by
  AccessManagementTable --> DepartmentsTable : requested_department
  AccessManagementTable --> RolesTable : requested_role
  AccessManagementTable --> AccountStatusTable : request_status

