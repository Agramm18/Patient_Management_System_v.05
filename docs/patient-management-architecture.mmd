flowchart LR
  %% Current architecture overview for Patient Management V5.01
  %% Paste into draw.io: Insert -> Advanced -> Mermaid

  classDef entry fill:#111827,stroke:#111827,color:#ffffff,stroke-width:2px
  classDef controller fill:#dbeafe,stroke:#2563eb,color:#1e3a8a,stroke-width:2px
  classDef config fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px
  classDef auth fill:#cffafe,stroke:#0891b2,color:#164e63,stroke-width:2px
  classDef repo fill:#ede9fe,stroke:#7c3aed,color:#4c1d95,stroke-width:2px
  classDef data fill:#fef3c7,stroke:#d97706,color:#78350f,stroke-width:2px
  classDef external fill:#f3f4f6,stroke:#6b7280,color:#111827,stroke-width:2px
  classDef decision fill:#fff7ed,stroke:#fb923c,color:#7c2d12,stroke-width:2px
  classDef planned fill:#f9fafb,stroke:#9ca3af,color:#374151,stroke-width:2px,stroke-dasharray: 6 4

  subgraph runtime["Runtime Entry"]
    direction TB
    Title["Patient Management V5.01<br/>Architecture Overview"]:::entry
    Main["app.Main<br/>creates Scanner<br/>starts boot"]:::entry
    Boot["BootConfigService<br/>system loader<br/>creates controllers"]:::entry
    Front["FrontController<br/>central dispatcher<br/>RequestType routing"]:::controller
  end

  subgraph controllers["Controller Layer"]
    direction TB
    ConfigCtrl["ConfigController<br/>runs startup checks"]:::controller
    AuthCtrl["AuthController<br/>auth menu<br/>registration | login | exit"]:::controller
    MenuCtrl["MenuController<br/>planned"]:::planned
    ServiceCtrl["ServiceController<br/>planned"]:::planned
    UiCtrl["uiController<br/>planned"]:::planned
  end

  subgraph configLayer["Configuration Layer"]
    direction TB
    Env["EnvValidationService<br/>checks .env file<br/>validates required values"]:::config
    Sql["SQLValidationService<br/>builds JDBC URL<br/>tests MySQL connection"]:::config
    DbManager["DBManager<br/>stores runtime DB config<br/>opens DB connections"]:::config
    SystemAccounts["SystemAccountValidationService<br/>checks local_admin<br/>checks admin"]:::config
    Defaults["SetDefaultAccounts<br/>creates missing defaults<br/>BCrypt password hashes"]:::config
    ConfigOk{"Config OK?"}:::decision
  end

  subgraph authLayer["Authentication Layer"]
    direction TB
    AuthMenu{"User choice"}:::decision
    Register["RegistrationService<br/>username<br/>email<br/>phone"]:::auth
    Password["PasswordService<br/>password rules<br/>confirm password<br/>BCrypt hash"]:::auth
    Login["LoginService<br/>username input<br/>password input"]:::auth
  end

  subgraph repositoryLayer["Repository Layer"]
    direction TB
    UserRepo["UserAccountRepository<br/>INSERT new account"]:::repo
    AuthRepo["AuthenticationService<br/>SELECT account<br/>BCrypt checkpw"]:::repo
  end

  subgraph storage["Storage & External Inputs"]
    direction TB
    DotEnv[".env<br/>DB settings<br/>default admin values"]:::external
    MySQL[("MySQL<br/>accounts table<br/>roles table")]:::data
    BCrypt["jbcrypt<br/>hashpw<br/>checkpw"]:::external
  end

  subgraph docs["Documentation"]
    direction TB
    Readme["README.md<br/>setup and current state"]:::external
    Activity["patient-management-activity.mmd<br/>detailed activity flow"]:::external
  end

  Title --> Main --> Boot --> Front

  Front -- CONFIG --> ConfigCtrl
  Front -- AUTH after config success --> AuthCtrl
  Front -. planned MENU .-> MenuCtrl
  Front -. planned SERVICE .-> ServiceCtrl
  Front -. planned UI .-> UiCtrl

  ConfigCtrl --> Env --> Sql --> DbManager --> SystemAccounts --> ConfigOk
  DotEnv --> Env
  Sql --> MySQL
  DbManager --> MySQL
  SystemAccounts --> MySQL
  SystemAccounts -- missing starter account --> Defaults
  Defaults --> BCrypt
  Defaults --> MySQL
  Defaults --> ConfigOk
  ConfigOk -- true --> AuthCtrl
  ConfigOk -- false --> Shutdown["boot stops<br/>system exits"]:::entry

  AuthCtrl --> AuthMenu
  AuthMenu -- registration --> Register --> Password --> UserRepo --> MySQL
  AuthMenu -- login --> Login --> AuthRepo --> MySQL
  AuthRepo --> BCrypt
  AuthMenu -- exit --> Exit["program exit"]:::entry

  Readme -. documents .-> Title
  Activity -. documents .-> Front
