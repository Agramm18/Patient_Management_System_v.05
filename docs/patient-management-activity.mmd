flowchart LR
  %% Patient Management V5.01 - Aktivitaetsdiagramm als Mermaid
  %% Copy-Paste in draw.io: Insert -> Advanced -> Mermaid

  classDef startEnd fill:#111827,stroke:#111827,color:#ffffff,stroke-width:2px
  classDef app fill:#dbeafe,stroke:#2563eb,color:#1e3a8a,stroke-width:2px
  classDef boot fill:#e0f2fe,stroke:#0284c7,color:#075985,stroke-width:2px
  classDef config fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px
  classDef db fill:#f3e8ff,stroke:#9333ea,color:#581c87,stroke-width:2px
  classDef auth fill:#cffafe,stroke:#0891b2,color:#164e63,stroke-width:2px
  classDef decision fill:#fff7ed,stroke:#fb923c,color:#7c2d12,stroke-width:2px
  classDef error fill:#fee2e2,stroke:#dc2626,color:#7f1d1d,stroke-width:2px
  classDef todo fill:#f3f4f6,stroke:#9ca3af,color:#374151,stroke-width:2px,stroke-dasharray: 6 4

  Start((Start)):::startEnd
  End((Ende)):::startEnd

  subgraph A["App-Start"]
    direction TB
    Main["Main.main()<br/>Scanner erstellen<br/>Begruessung ausgeben"]:::app
    Hello["BootConfigService<br/>DisplayHelloMSG()<br/>System Loader anzeigen"]:::app
  end

  subgraph B["Bootstrap & Routing"]
    direction TB
    SystemConfig["SystemConfig(scanner)<br/>Start der Boot-Phase"]:::boot
    ControllerObjects["Controller anlegen<br/>Auth, Config, Menu,<br/>Service, UI"]:::boot
    FrontController["FrontController<br/>zentraler Dispatcher<br/>RequestType auswerten"]:::boot
    RouteConfig["Route: CONFIG"]:::config
    RouteAuth["Route: AUTH"]:::auth
  end

  subgraph C["Konfiguration"]
    direction TB
    ConfigExec["ConfigController.execute()<br/>Config-Flow starten"]:::config
    EnvFile["EnvValidationService<br/>CheckFileStatus()<br/>.env suchen"]:::config
    EnvExists{".env<br/>vorhanden?"}:::decision
    EnvValues["CheckENVParam()<br/>DB-Werte pruefen<br/>Default-Account-Werte pruefen"]:::config
    EnvValid{"Pflichtwerte<br/>valide?"}:::decision
    SqlConn["SQLValidationService<br/>JDBC-URL bauen<br/>DriverManager testen"]:::config
    DbReachable{"MySQL<br/>erreichbar?"}:::decision
    DbManager["DBManager.initialize()<br/>globale DB-Runtime-Konfig speichern"]:::config
  end

  subgraph D["Datenbank & Accounts"]
    direction TB
    AccountFlow["SystemAccountValidationService<br/>DBAccounts()"]:::db
    CheckLocal["CheckLocalAdmin()<br/>SELECT user_role = local_admin"]:::db
    CheckAdmin["CheckAdmin()<br/>SELECT user_role = admin"]:::db
    Roles{"Starter-Rollen<br/>vorhanden?"}:::decision
    CreateDefaults["SetDefaultAccounts<br/>fehlende Admins erzeugen<br/>BCrypt + INSERT accounts"]:::db
    ConfigOk{"configOK<br/>true?"}:::decision
    ConfigError["Config-Fehlerpfad<br/>Fehler ausgeben<br/>Auth startet nicht"]:::error
  end

  subgraph E["Authentifizierung"]
    direction TB
    VerifyAuth["AuthController<br/>VerifyAccountStatus()<br/>fragt Y/N"]:::auth
    AccountExists{"Account<br/>existiert?"}:::decision
    LoginTodo["LoginService<br/>aktuell: Not implemented yet"]:::todo
    Registration["RegistrationService<br/>UserAccount(scanner)"]:::auth
    RegData["Username, E-Mail, Telefon<br/>mit Eingabe-Validierung<br/>danach Daten anzeigen"]:::auth
    DataOk{"Daten<br/>korrekt?"}:::decision
    EditData["Feld aendern<br/>1 Username / 2 E-Mail / 3 Telefon<br/>aktueller Code endet danach"]:::todo
    PasswordFlow["PasswordService<br/>PlainPWSD() + ValidatePWSD()<br/>mind. 10, gross/klein,<br/>Zahl, Sonderzeichen"]:::auth
    PasswordMatch{"Passwort<br/>bestaetigt?"}:::decision
    HashDone["ConvertCharToString()<br/>PlainToHash()<br/>BCrypt Hash erzeugen"]:::auth
    NoSave["Registrierung<br/>Hash vorhanden,<br/>DB-Speicherung noch offen"]:::todo
  end

  PlaceholderNote["Noch vorhandene Platzhalter:<br/>MenuController, ServiceController, uiController, CLIText.<br/>FrontController kennt MENU, SERVICE, UI und EXIT,<br/>routet aktuell aber nur CONFIG und AUTH."]:::todo

  Start --> Main --> Hello --> SystemConfig
  SystemConfig --> ControllerObjects --> FrontController --> RouteConfig --> ConfigExec

  ConfigExec --> EnvFile --> EnvExists
  EnvExists -- ja --> EnvValues --> EnvValid
  EnvExists -- nein --> ConfigError
  EnvValid -- ja --> SqlConn --> DbReachable
  EnvValid -- nein --> ConfigError
  DbReachable -- ja --> DbManager --> AccountFlow
  DbReachable -- nein --> ConfigError

  AccountFlow --> CheckLocal --> CheckAdmin --> Roles
  Roles -- beide vorhanden --> ConfigOk
  Roles -- einer oder beide fehlen --> CreateDefaults --> ConfigOk
  ConfigOk -- ja --> RouteAuth
  ConfigOk -- nein --> ConfigError
  ConfigError --> End

  RouteAuth --> VerifyAuth --> AccountExists
  AccountExists -- leer oder ungueltig --> VerifyAuth
  AccountExists -- Y --> LoginTodo --> End
  AccountExists -- N --> Registration --> RegData --> DataOk
  DataOk -- nein --> EditData --> End
  DataOk -- ja --> PasswordFlow
  PasswordFlow -- ungueltig: erneut eingeben --> PasswordFlow
  PasswordFlow -- valide --> PasswordMatch
  PasswordMatch -- nein --> DataOk
  PasswordMatch -- ja --> HashDone --> NoSave --> End

  PlaceholderNote -. Strukturhinweis .- FrontController
