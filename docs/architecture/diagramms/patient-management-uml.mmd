%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 36, "rankSpacing": 48}}}%%
flowchart TD
  %% Patient Management System V5.01
  %% Last synchronized: 2026-07-31

  Start([Start]) --> Main["Main.main<br/>Create Scanner and show StartMSG"]
  Main --> Boot["BootConfigService<br/>Create controllers and dispatcher"]
  Fatal["Generic fatal handler<br/>Print System Config Failed<br/>System.exit(1)"]
  ProgramEnd([Current runtime ends])

  subgraph Config["1. Configuration"]
    ConfigRequest["FrontController CONFIG"] --> ConfigController["ConfigController.execute"]
    ConfigController --> Env["EnvValidationService and EnvSetup<br/>Validate 13 values"]
    Env --> Sql["SQLValidationService<br/>Test JDBC URL"]
    Sql --> Db["DBManager.initialize<br/>Store static settings"]
    Db --> RecoveryHash["HandleRecoveryKey<br/>BCrypt cost 12"]
    RecoveryHash --> RecoveryPersist["SetRecoveryKey<br/>Upsert row 1"]
    RecoveryPersist --> Starter["CheckForDefaultAccounts<br/>Create missing roles 1 and 2"]
    Starter --> ConfigOk{"Configuration successful?"}
  end

  Boot --> ConfigRequest
  ConfigOk -->|No| Fatal

  subgraph Authentication["2. Authentication"]
    AuthRequest["FrontController AUTH"] --> AuthController["AuthController"]
    AuthController --> AuthMenu["Register / Login / Recovery / Exit"]
    AuthMenu --> AuthChoice{"Choice"}
  end

  ConfigOk -->|Yes| AuthRequest
  AuthChoice -->|Invalid| AuthMenu
  AuthChoice -->|Exit| Exit([System.exit 0])

  subgraph Registration["2a. Registration"]
    RegistrationFlow["RegistrationFlow"] --> RegistrationService["RegistrationService<br/>Validate, correct, confirm"]
    RegistrationService --> PasswordService["PasswordService<br/>Validate, compare, hash, clear arrays"]
    PasswordService --> CreateAccount["CreateAccount<br/>Insert pending role-9 account"]
  end

  AuthChoice -->|Register| RegistrationFlow
  CreateAccount --> AuthMenu

  subgraph Login["2b. Login, outcome, and policy"]
    LoginFlow["LoginFlow<br/>Credential loop"] --> LoginInput["CollectLoginValues<br/>Username and hidden password"]
    LoginInput --> Setup["SetupCurrentSession"]
    Setup --> Exists{"Account exists?"}
    Exists -->|No| Unknown["StoreLogs<br/>USERNAME_NOT_FOUND"]
    Exists -->|Yes| PasswordOk{"BCrypt password matches?"}

    PasswordOk -->|No| Policy["PasswordPolicies"]
    Policy --> Counts["CountFailedLoginAttempts<br/>Day / week / month / year / 5y / 10y"]
    Counts --> Include["PolicieThresholdStructure.includingAttempt"]
    Include --> Threshold["PolicyThreshold<br/>Quarantine, suspicious, locked"]
    Threshold --> Invalid["StoreLogs<br/>INVALID_PASSWORD"]

    PasswordOk -->|Yes| StatusLookup["CheckInput.status"]
    StatusLookup --> Status["HandleAccountStatus"]
    Status --> Active["active<br/>Create SessionAccount<br/>Set CurrentSession<br/>PERMITTED"]
    Status --> Pending["pending<br/>FirstLoginFlow<br/>PENDING_REQUEST"]
    Status --> Change["waiting_for_password_change<br/>UpdateUserPassword<br/>PASSWORD_CHANGED or WAITING"]
    Status --> Rejected["disabled / locked / quarantine / suspicious<br/>REJECTED"]
    Status --> StatusError["unknown / SQL / input outcome"]

    Unknown --> Persist["logsRepository.CollectLogs<br/>is_success only for PERMITTED"]
    Invalid --> Persist
    Active --> Persist
    Pending --> Persist
    Change --> Persist
    Rejected --> Persist
    StatusError --> Persist

    Persist --> Outcome{"LoginOutcome"}
    Outcome -->|PERMITTED| SessionGate{"Session active and menu-enabled?"}
    Outcome -->|PENDING_REQUEST or PASSWORD_CHANGED| ReturnAuth["Return to authentication"]
    Outcome -->|Other| LoginInput
  end

  AuthChoice -->|Login| LoginFlow
  ReturnAuth --> AuthMenu
  SessionGate -->|No| AuthMenu

  subgraph Recovery["2c. Recovery"]
    RecoveryFlow["RecoveryFlow"] --> KeyInput["ValidateRecoveryKey<br/>Hidden input"]
    KeyInput --> StoredKey["GetRecoveryKeyHash<br/>Row 1"]
    StoredKey --> KeyOk{"BCrypt key matches?"}
    KeyOk -->|No| KeyRetry["Retry counter<br/>Stop after four failures"]
    KeyRetry -->|Retry| KeyInput
    KeyOk -->|Yes| ListSystem["FindRecoverableUser<br/>Display system accounts"]
    ListSystem --> SelectUser["SelectUserForRecover<br/>Currently accepts any account"]
    SelectUser --> RecoveryPassword["PasswordService"]
    RecoveryPassword --> RecoveryUpdate["UpdateSystemAccountPassword<br/>Set hash and status ID 1"]
  end

  AuthChoice -->|Recovery| RecoveryFlow
  KeyRetry -->|Limit| AuthMenu
  RecoveryUpdate --> AuthMenu

  subgraph MenuService["3. Menu and service"]
    MenuRequest["FrontController MENU"] --> MenuController["MenuControllerParent"]
    MenuController --> Role{"Role ID"}
    Role -->|1| LocalAdmin["LocalAdminMenu<br/>LOCAL_ADMIN_DASHBOARD"]
    Role -->|2| Admin["AdminMenu<br/>Five MenuOption records"]
    Admin --> Choice["MenuFlow<br/>Selected ServiceAction"]
    LocalAdmin --> Context["MenuContextStructure"]
    Choice --> Context
    Context --> ServiceRequest["FrontController SERVICE"]
    ServiceRequest --> Service["ServiceController"]
    Service --> Action{"ServiceAction"}
    Action -->|ADMIN_USER_REQUESTS| Requests["ShowCurrentRequests<br/>Print all joined rows"]
    Action -->|Other| Unsupported["IllegalStateException"]
  end

  SessionGate -->|Yes| MenuRequest
  Role -->|Other| Fatal
  Unsupported --> Fatal
  Requests --> ProgramEnd

  subgraph CrossCutting["4. Cross-cutting and disconnected"]
    Logs["LogManager and logback.xml<br/>Console plus non-rolling files"]
    Tests["JUnit 5<br/>15 password plus 40 registration tests"]
    Clear["CurrentSession.clear<br/>No production caller"]
    Placeholders["UIController / RequestMenu / RouteService / CollectUserJob"]
    Undispatched["FrontController UI and EXIT<br/>Declared but not handled"]
  end

  Boot -.-> Logs
  RegistrationService -.-> Tests
  Active -.-> Clear
  Service -.-> Placeholders
  Boot -.-> Undispatched

  classDef error fill:#fee2e2,stroke:#b91c1c,color:#450a0a;
  classDef warning fill:#fef3c7,stroke:#d97706,color:#422006;
  classDef success fill:#dcfce7,stroke:#15803d,color:#052e16;
  class Fatal,Unsupported error;
  class Pending,Change,Rejected,KeyRetry,SelectUser warning;
  class Active,Requests success;
