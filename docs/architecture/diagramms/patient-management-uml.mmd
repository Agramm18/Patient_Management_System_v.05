%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, Arial, sans-serif", "fontSize": "15px", "primaryTextColor": "#1f2937", "lineColor": "#64748b", "clusterBkg": "#f8fafc", "clusterBorder": "#cbd5e1", "edgeLabelBackground": "#ffffff"}, "flowchart": {"curve": "basis", "nodeSpacing": 46, "rankSpacing": 58, "padding": 14}}}%%
flowchart TD
  %% Patient Management System V5.01
  %% Last synchronized: 2026-06-18
  %% Diagram type: complete activity flow plus class and method map

  Start([Start application]):::terminal
  MainEntry["Main.main<br/>Create Scanner<br/>Show StartMSG"]:::entry
  BootEntry["BootConfigService.displayLoader<br/>BootConfigService.SystemConfig<br/>Create controllers and dispatcher"]:::entry

  Start --> MainEntry --> BootEntry

  subgraph MainFlow["Runtime control flow"]
    direction TD

    subgraph ConfigFlow["1. System configuration"]
      direction TD
      ConfigCtl["FrontController.navigateSubController<br/>RequestType.CONFIG"]:::controller
      ConfigExec["ConfigController.execute"]:::controller
      EnvValidate["EnvValidationService.envStatus<br/>Validate .env file and values"]:::step
      SqlValidate["SQLValidationService.DBConnection<br/>Build and test JDBC URL"]:::step
      DbInit["DBManager.initialize<br/>Store global DB runtime config"]:::data
      RecoveryKey["HandleRecoveryKey.plainKey<br/>HandleRecoveryKey.hashedKey<br/>Hash RECOVERY_KEY"]:::secure
      StoreRecovery["SetRecoveryKey.keyValue<br/>Persist recovery key hash"]:::data
      DefaultAccounts["CheckForDefaultAccounts.dbAccounts<br/>CreateDefaultAccounts.defaultAccounts"]:::data
      ConfigOk{"Configuration OK?"}:::decision

      ConfigCtl --> ConfigExec --> EnvValidate --> SqlValidate --> DbInit --> RecoveryKey --> StoreRecovery --> DefaultAccounts --> ConfigOk
    end

    subgraph AuthLoopFlow["2. Authentication menu loop"]
      direction TD
      AuthHeader["AuthMSG.msg"]:::ui
      AuthRoute["FrontController.navigateSubController<br/>RequestType.AUTH"]:::controller
      AuthControllerNode["AuthController.verifyAccountStatus"]:::controller
      AuthMenuNode["AuthMenu.authMenu"]:::ui
      AuthChoice{"User choice"}:::decision

      AuthHeader --> AuthRoute --> AuthControllerNode --> AuthMenuNode --> AuthChoice
    end

    subgraph RegisterFlow["2a. Register branch"]
      direction TD
      RegistrationFlowNode["RegistrationFlow.user"]:::flow
      RegistrationServiceNode["RegistrationService.userAccunt<br/>Collect username, email, phone"]:::step
      RegistrationPassword["PasswordFlow.policy<br/>PasswordService.userPWSD<br/>Create BCrypt hash"]:::secure
      RegistrationSave["CreateAccount.newAccount<br/>Save account"]:::data

      RegistrationFlowNode --> RegistrationServiceNode --> RegistrationPassword --> RegistrationSave
    end

    subgraph LoginFlow["2b. Login branch"]
      direction TD
      LoginFlowNode["LoginFlow.user<br/>Login loop"]:::flow
      LoginInputNode["LoginInputCollector.user<br/>Collect username and password"]:::step
      LoginVerify["LoginVerification.loggedUser"]:::secure
      UserExists{"CheckUserInDB.checkUserInDB<br/>User exists?"}:::decision
      PasswordOk{"CheckUserInDB.checkPWSD<br/>Password valid?"}:::decision
      FailedPolicy["CountFailedLoginAttempts.Logs<br/>ExecutePWSDPolicy.locked<br/>ExecutePWSDPolicy.suspicious<br/>ExecutePWSDPolicy.quarantine"]:::secure
      SaveFailed["logsRepository.CollectLogs.loginAttempts<br/>Save failed attempt"]:::data
      StatusCheck["CheckUserInDB.checkUserStatus"]:::data
      Status{"Account status"}:::decision

      LoginFlowNode --> LoginInputNode --> LoginVerify --> UserExists
      UserExists -->|No| SaveFailed --> LoginInputNode
      UserExists -->|Yes| PasswordOk
      PasswordOk -->|No| FailedPolicy --> SaveFailed
      PasswordOk -->|Yes| StatusCheck --> Status
    end

    subgraph LoginStatusFlow["2c. Login status outcomes"]
      direction TD
      ActiveStatus["active<br/>CollectLoginValues.loginValues"]:::success
      SessionObject["CurrentUser<br/>CurrentSession.setCurrentUser"]:::success
      SaveSuccess["logsRepository.CollectLogs.loginAttempts<br/>Save successful attempt"]:::data
      PendingStatus["pending<br/>FirstLogin.firstSetup"]:::warning
      PasswordChangeStatus["waiting_for_password_change<br/>PasswordService.userPWSD<br/>UpdateUserPassword.dbValues"]:::secure
      SuspiciousStatus["suspicious<br/>Warn user, continue without active menu session"]:::warning
      BlockedStatus["disabled, locked, quarantine<br/>Reject login"]:::error
      UnknownStatus["unknown or null<br/>Reject login"]:::error
      SessionReady{"CurrentSession exists<br/>menu access true<br/>status active?"}:::decision

      Status -->|active| ActiveStatus --> SessionObject --> SaveSuccess --> SessionReady
      Status -->|pending| PendingStatus
      Status -->|password change| PasswordChangeStatus --> SaveSuccess
      Status -->|suspicious| SuspiciousStatus --> SaveSuccess
      Status -->|blocked| BlockedStatus --> SaveFailed
      Status -->|unknown| UnknownStatus --> SaveFailed
    end

    subgraph PendingSetupFlow["2d. Pending user setup"]
      direction TD
      DepartmentMenuNode["DepartmentMenu.departments"]:::ui
      CollectDepartment["CollectUserDepartment.department<br/>CollectUserDepartment.getSelectedDepartment"]:::step
      DepartmentChoice{"Selected department"}:::decision
      DepartmentJobs["Department job menus<br/>Medical, Emergency, Laboratory, Pharmacy,<br/>IT, Security, Finance, Office,<br/>Administration, Training, System"]:::ui
      SystemAccess["HasAssignedDepartment.status<br/>Protect system jobs"]:::secure
      AccessRequest["CreateAccessRequest.accessManagement<br/>Store access request"]:::data

      PendingStatus --> DepartmentMenuNode --> CollectDepartment --> DepartmentChoice
      DepartmentChoice -->|Normal department| DepartmentJobs --> AccessRequest
      DepartmentChoice -->|System department| SystemAccess --> DepartmentJobs
      AccessRequest --> SaveSuccess
    end

    subgraph RecoveryFlow["2e. Recovery branch"]
      direction TD
      RecoveryStart["RecoveryFlow.SystemAccounts"]:::flow
      RecoveryInput["ValidateRecoveryKey.keyValues<br/>ValidateRecoveryKey.getEnteredHashByUser"]:::secure
      RecoveryHashLoad["GetRecoveryKeyHash.key<br/>GetRecoveryKeyHash.getDbValue"]:::data
      RecoveryCheck["CheckKeyStatus.Value"]:::secure
      RecoveryValid{"Recovery key valid?"}:::decision
      RecoveryRetry["Retry counter<br/>max 4"]:::warning
      SelectRecoverUser["SelectUserForRecovery.username<br/>SelectUserForRecovery.getRecoverUsername"]:::step
      RecoverUserExists{"SelectUserForRecover.inDB<br/>Account exists?"}:::decision
      ResetSystemPassword["PasswordService.userPWSD<br/>UpdateSystemAccountPassword.sqlQuerry"]:::data

      RecoveryStart --> RecoveryInput --> RecoveryHashLoad --> RecoveryCheck --> RecoveryValid
      RecoveryValid -->|No| RecoveryRetry
      RecoveryRetry -->|Retry left| RecoveryInput
      RecoveryRetry -->|Limit reached| AuthMenuNode
      RecoveryValid -->|Yes| SelectRecoverUser --> RecoverUserExists
      RecoverUserExists -->|No| AuthMenuNode
      RecoverUserExists -->|Yes| ResetSystemPassword --> AuthMenuNode
    end

    subgraph MenuServiceFlow["3. Menu and service"]
      direction TD
      BootAccess{"BootConfigService reads<br/>CurrentSession.getCurrentUser<br/>hasAccessToMenu?"}:::decision
      MenuRoute["FrontController.navigateSubController<br/>RequestType.MENU"]:::controller
      MenuControllerNode["MenuController.routeMenu<br/>Read CurrentUser.getRole"]:::controller
      RoleChoice{"User role"}:::decision
      LocalAdminNode["LocalAdminMenu.localAdminMenu"]:::ui
      AdminNode["AdminMenu.showMenu<br/>AdminMenu.getMenuSize"]:::ui
      AdminChoiceNode["MenuFlow.chooseOption<br/>MenuValues record"]:::step
      NoRoleNode["No switch case implemented"]:::warning
      ServiceRoute["FrontController.navigateSubController<br/>RequestType.SERVICE"]:::controller
      ServiceControllerNode["ServiceController.routeService<br/>Use MenuValues role and choice"]:::controller
      ServiceRoleChoice{"Service role"}:::decision
      LocalAdminServiceNode["startLocalAdminService<br/>Log service start only"]:::placeholder
      AdminServiceChoice{"Admin choice"}:::decision
      ShowRequestsNode["ShowCurrentRequests.CurrentRequests<br/>Print access requests"]:::data
      UnimplementedAdminChoice["Admin choices 2-8<br/>No action yet"]:::placeholder
      Done([End of current implemented flow]):::terminal

      BootAccess -->|Yes| MenuRoute --> MenuControllerNode --> RoleChoice
      RoleChoice -->|Local admin| LocalAdminNode --> ServiceRoute
      RoleChoice -->|Admin| AdminNode --> AdminChoiceNode --> ServiceRoute
      RoleChoice -->|Other| NoRoleNode --> FatalExit
      ServiceRoute --> ServiceControllerNode --> ServiceRoleChoice
      ServiceRoleChoice -->|Local admin| LocalAdminServiceNode --> Done
      ServiceRoleChoice -->|Admin| AdminServiceChoice
      AdminServiceChoice -->|1| ShowRequestsNode --> Done
      AdminServiceChoice -->|2-8| UnimplementedAdminChoice --> Done
    end
  end

  BootEntry --> ConfigCtl
  ConfigOk -->|No| FatalExit["Print config error<br/>Log failure<br/>System.exit 1"]:::error
  ConfigOk -->|Yes| AuthHeader
  AuthChoice -->|Register| RegistrationFlowNode
  RegistrationSave --> AuthMenuNode
  AuthChoice -->|Login| LoginFlowNode
  AuthChoice -->|Recovery| RecoveryStart
  AuthChoice -->|Exit| ExitProgram["System.exit 0"]:::terminal
  AuthChoice -->|Invalid input| AuthMenuNode
  SessionReady -->|No| AuthMenuNode
  SessionReady -->|Yes| BootAccess
  BootAccess -->|No| FatalExit

  subgraph MethodMap["4. Complete class and public method map"]
    direction TD

    subgraph AppAndControllers["Application and controllers"]
      direction LR
      AppMethods["Main.main<br/>BootConfigService.displayLoader<br/>BootConfigService.SystemConfig<br/>FrontController.navigateSubController<br/>RequestType enum: CONFIG, AUTH, MENU, SERVICE, UI, EXIT"]:::catalog
      ControllerMethods["ConfigController.execute<br/>AuthController.verifyAccountStatus<br/>MenuController.routeMenu<br/>ServiceController.routeService<br/>uiController placeholder"]:::catalog
    end

    subgraph ConfigMethods["Configuration and logging"]
      direction LR
      EnvMethods["EnvValidationService.envStatus<br/>EnvValidationService.setEnvValues<br/>EnvValidationService.getHost<br/>EnvValidationService.getPort<br/>EnvValidationService.getDBName<br/>EnvValidationService.getUser<br/>EnvValidationService.getPassword"]:::catalog
      SqlMethods["SQLValidationService.DBConnection<br/>SQLValidationService.getSQLUser<br/>SQLValidationService.getSqlPWSD<br/>SQLValidationService.getSqlURL<br/>DBManager.initialize<br/>DBManager.getConnection"]:::catalog
      RecoveryConfigMethods["HandleRecoveryKey.plainKey<br/>HandleRecoveryKey.hashedKey<br/>HandleRecoveryKey.getRecoveryKeyHashed<br/>LogManager.log<br/>LogType enum"]:::catalog
    end

    subgraph AuthMethods["Authentication flows and services"]
      direction LR
      FlowMethods["RegistrationFlow.user<br/>LoginFlow.user<br/>PasswordFlow.policy<br/>RecoveryFlow.SystemAccounts<br/>CurrentSession.setCurrentUser<br/>CurrentSession.getCurrentUser"]:::catalog
      RegistrationMethods["RegistrationService.userAccunt<br/>RegistrationService.getUserName<br/>RegistrationService.getEmailAddress<br/>RegistrationService.getPhoneNumber<br/>RegistrationService.getHashedPWSD<br/>PasswordService.userPWSD<br/>PasswordService.getHashedPWSD"]:::catalog
      LoginMethods["LoginInputCollector.user<br/>LoginInputCollector.getEnteredUserName<br/>LoginInputCollector.getEnteredPWSD<br/>LoginVerification.loggedUser<br/>UserStatus enum<br/>CurrentUser.loginResult<br/>CurrentUser.getUserID<br/>CurrentUser.getUserName<br/>CurrentUser.isSystemAccount<br/>CurrentUser.getAccountStatus<br/>CurrentUser.hasAccessToMenu<br/>CurrentUser.getRole"]:::catalog
      SecurityMethods["FirstLogin.firstSetup<br/>CollectUserDepartment.department<br/>CollectUserDepartment.getSelectedDepartment<br/>CollectUserRole.requestRoles<br/>CollectUserJob placeholder<br/>AccountPolicy placeholder<br/>Audit CollectLogs.isSuccess<br/>Audit CollectLogs.getFailureReason"]:::catalog
      RecoveryMethods["ValidateRecoveryKey.keyValues<br/>ValidateRecoveryKey.getEnteredHashByUser<br/>CheckKeyStatus.Value<br/>SelectUserForRecovery.username<br/>SelectUserForRecovery.getRecoverUsername"]:::catalog
    end

    subgraph RepositoryMethods["Repositories"]
      direction LR
      ConfigRepos["CheckForDefaultAccounts.dbAccounts<br/>CheckForDefaultAccounts.checkLocalAdmin<br/>CheckForDefaultAccounts.checkAdmin<br/>CheckForDefaultAccounts.validateResults<br/>CreateDefaultAccounts.defaultAccounts<br/>SetRecoveryKey.keyValue"]:::catalog
      LoginRepos["CheckUserInDB.checkUserInDB<br/>CheckUserInDB.checkPWSD<br/>CheckUserInDB.checkUserStatus<br/>CollectLoginValues.loginValues<br/>CollectLoginValues.gethasAccesToMenu<br/>CollectLoginValues.getUserStatus<br/>CollectLoginValues.getUserID<br/>CollectLoginValues.isSystemAccount<br/>CollectLoginValues.getUserRole<br/>logsRepository.CollectLogs.loginAttempts"]:::catalog
      AuthMgmtRepos["CountFailedLoginAttempts.Logs<br/>CountFailedLoginAttempts.getRETRY_COUNT_24_H<br/>CreateAccessRequest.accessManagement<br/>HasAssignedDepartment.status<br/>HasAssignedRole.userRole<br/>SetNewStatus placeholder"]:::catalog
      PasswordRepos["ExecutePWSDPolicy.locked<br/>ExecutePWSDPolicy.suspicious<br/>ExecutePWSDPolicy.quarantine<br/>UpdateUserPassword.dbValues<br/>UpdateSystemAccountPassword.sqlQuerry<br/>SystemAccountRequiresPasswordChange.checkUserStatus"]:::catalog
      RecoveryRepos["GetRecoveryKeyHash.key<br/>GetRecoveryKeyHash.getDbValue<br/>FindRecoverableUser.systemAccounts<br/>SelectUserForRecover.inDB<br/>CreateAccount.newAccount"]:::catalog
      ServiceRepos["ShowCurrentRequests.CurrentRequests"]:::catalog
    end

    subgraph UiMethods["CLI text and menu classes"]
      direction LR
      DisplayMethods["StartMSG.startMSG<br/>LoaderMSG.message<br/>AuthMSG.msg<br/>ConfigMSG.configMSG<br/>DefaultAccountsMSG.msg"]:::catalog
      ProgramMenus["AuthMenu.authMenu<br/>roleMenu.roles<br/>DepartmentMenu.departments<br/>AdminMenu.showMenu<br/>AdminMenu.getMenuSize<br/>LocalAdminMenu.localAdminMenu"]:::catalog
      JobMenus["MedicalJobsMenu.jobsMenu<br/>EmergencyJobsMenu.jobsMenu<br/>LaboratoryJobsMenu.jobsMenu<br/>PharmacyJobsMenu.jobsMenu<br/>itJobsMenu.jobsMenu<br/>SecurityJobsMenu.jobsMenu<br/>FinanceJobsMenu.jobsMenu<br/>OfficeJobsMenu.jobsMenu<br/>AdministrationJobsMenu.jobsMenu<br/>TrainingJobsMenu.jobsMenu<br/>SystemJobsMenu.jobsMenu"]:::catalog
      MenuRuntime["MenuFlow.chooseOption<br/>MenuValues record: userChoice, userRole<br/>RouteService.userChoice placeholder"]:::catalog
    end
  end

  ConfigCtl -. method map .-> AppMethods
  EnvValidate -. details .-> EnvMethods
  LoginVerify -. details .-> LoginMethods
  StatusCheck -. repository details .-> LoginRepos
  DepartmentJobs -. menu details .-> JobMenus
  ServiceControllerNode -. selected values .-> MenuRuntime
  ShowRequestsNode -. repository details .-> ServiceRepos

  classDef terminal fill:#e0f2fe,stroke:#0369a1,stroke-width:2px,color:#0c2d48;
  classDef entry fill:#eaf3ff,stroke:#2563eb,stroke-width:1.5px,color:#0f172a;
  classDef step fill:#f8fafc,stroke:#475569,stroke-width:1.3px,color:#1f2937;
  classDef controller fill:#eef2ff,stroke:#4f46e5,stroke-width:1.5px,color:#1e1b4b;
  classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:1.7px,color:#422006;
  classDef ui fill:#f3e8ff,stroke:#7e22ce,stroke-width:1.4px,color:#3b0764;
  classDef secure fill:#fee2e2,stroke:#b91c1c,stroke-width:1.4px,color:#450a0a;
  classDef data fill:#dcfce7,stroke:#16a34a,stroke-width:1.4px,color:#052e16;
  classDef success fill:#dcfce7,stroke:#15803d,stroke-width:1.5px,color:#052e16;
  classDef warning fill:#fef9c3,stroke:#ca8a04,stroke-width:1.4px,color:#422006;
  classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:1.7px,color:#450a0a;
  classDef flow fill:#fff7ed,stroke:#c2410c,stroke-width:1.4px,color:#431407;
  classDef placeholder fill:#f1f5f9,stroke:#94a3b8,stroke-width:1.4px,stroke-dasharray:5 4,color:#334155;
  classDef catalog fill:#ffffff,stroke:#94a3b8,stroke-width:1.1px,color:#1f2937;
